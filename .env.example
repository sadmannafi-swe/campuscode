# ---- Frontend (public, safe to expose; bundled into the client) ----
# Supabase project URL and anon (publishable) key — Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- NEVER put secrets in VITE_* variables. ----
# Server-side secrets are set on Supabase Edge Functions, not here:
#   supabase secrets set JUDGE0_URL=... JUDGE0_API_KEY=... (see README → Judge0 setup)
# The service-role key is only used by scripts/grant-admin.mjs from your own machine:
#   SUPABASE_SERVICE_ROLE_KEY=...   (export in your shell, never commit)
